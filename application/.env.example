# ============================================================
# Competency Framework — Environment Variables
# Copy this file to .env.local and fill in your values.
#
# Quick start (Docker local, no Supabase account needed):
#   1. cp .env.example .env.local
#   2. docker compose up -d          # starts Postgres on port 5434
#   3. pnpm install
#   4. pnpm db:setup                 # schema + seed templates + bootstrap workspace
#   5. pnpm dev
#   6. Open http://localhost:3000  → auto-logged-in as dev@local.test
#
# Remove DEV_AUTH_BYPASS_* before deploying to production.
# ============================================================

# ===== Database ==============================================
# Option A — Local Docker Postgres (default, run: docker compose up -d)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/competency
DATABASE_URL_DIRECT=postgresql://postgres:postgres@localhost:5434/competency

# Option B — Managed Supabase (free tier)
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:6543/postgres
# DATABASE_URL_DIRECT=postgresql://postgres.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres

# Option C — Any Postgres (Railway, Render, Neon, local install)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# ===== Supabase Auth =========================================
# Required for production. For local dev with DEV_AUTH_BYPASS, placeholders work.
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

# Production: fill in real Supabase keys from Settings → API
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ===== Dev Auth Bypass =======================================
# Auto-logs-in without Supabase in NODE_ENV !== 'production'.
# User ID is seeded into the DB by pnpm db:setup — do not change.
DEV_AUTH_BYPASS_USER_ID=00000000-0000-0000-0000-000000000001
DEV_AUTH_BYPASS_EMAIL=dev@local.test
NEXT_PUBLIC_DEV_BYPASS_HINT=1

# ===== App ===================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===== AI features (optional) ================================
# Required for AI-generate exercises. Leave blank to use stub responses.
# ANTHROPIC_API_KEY=sk-ant-...
